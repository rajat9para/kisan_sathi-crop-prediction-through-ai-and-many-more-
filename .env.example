# ================================================================
# Kisaan_Sathi Environment Variables for Local & Cloud Deployment
# ================================================================

# Groq LLM API Key (for ultra-fast LLaMA farmer conversational advisory)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FAST_MODEL=llama-3.1-8b-instant

# data.gov.in API Key — REAL Agmarknet live mandi prices (free registration)
# Register at https://data.gov.in/user/register then request an API key.
# Without this, the system falls back to cached snapshots, then clearly-labelled estimates.
DATA_GOV_API_KEY=your_data_gov_api_key_here

# Copernicus Data Space Ecosystem OAuth client — REAL Sentinel-2 NDVI (free)
# Register at https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# and create an OAuth client. Without this, NDVI responses are labelled 'estimated'.
CDSE_CLIENT_ID=your_cdse_oauth_client_id
CDSE_CLIENT_SECRET=your_cdse_oauth_client_secret

# Supabase PostgreSQL Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_secret_service_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# CORS: comma-separated extra allowed origins (your Vercel frontend URL etc.)
ALLOWED_ORIGINS=https://your-frontend.vercel.app
